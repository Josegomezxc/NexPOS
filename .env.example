# Entorno de producción (PythonAnywhere, Render, etc.)
# Copiar a .env y completar los valores.

SECRET_KEY=poner-una-clave-aleatoria-larga-aqui
DEBUG=False

# Dominio/s del sitio (separados por coma)
ALLOWED_HOSTS=andreszxc.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=https://andreszxc.pythonanywhere.com

# Motor de base de datos: sqlite para hosting gratuito (PythonAnywhere),
# postgres (o DATABASE_URL) para el resto.
DB_ENGINE=sqlite

# Solo si el proxy no envía X-Forwarded-Proto y hay bucles de redirect:
# SECURE_SSL_REDIRECT=False

NEGOCIO_NOMBRE=NexPOS
TIME_ZONE=America/Guayaquil
